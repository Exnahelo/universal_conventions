{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "check:naming",
      "type": "process",
      "command": "python3",
      "args": ["scripts/check_naming.py", "--root", "${workspaceFolder}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "naming",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      },
      "group": "test"
    }
  ]
}
